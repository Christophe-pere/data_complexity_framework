# Code-only repository.
# Results, logs, reports, datasets, docs and manuscripts stay local; only
# source files (.py, .sh) plus README.md and LICENSE are tracked.

# Python / environments
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Non-code directories
docs/
datasets/*
paper*/
geometry/
qml-extract/
.memsearch/
experiments/results/

# Results, data and reports (any directory)
*.json
*.jsonl
*.log
*.csv
*.txt
!requirements*.txt
*.npy
*.npz
*.h5
*.dem
*.stim
*.b8
*.bak
*.bak-*
*.zip
*.pdf
*.png
*.svg
*.tex
*.bbl
*.aux

# Markdown other than the top-level README
*.md
!/README.md

# Agent and OS files
CLAUDE.md
.DS_Store
.log

# Exception: the dataset registry lets anyone rebuild the suite deterministically
!datasets/registry.json
